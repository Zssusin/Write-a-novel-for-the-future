---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { getRelativeLocaleUrl } from "astro:i18n";
import { resolveDefaultOgImagePath } from "@/utils/resolveDefaultOgImagePath";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";
import "@/styles/global.css";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  /*
    文章页要报 "article"。**必须走这个 prop，不能在子布局里再补一条
    <meta property="og:type">** —— og 协议里同名 property 出现两次时，
    抓取器普遍取第一条（后面的当多值处理），于是文章页会被读成 website。
  */
  ogType?: "website" | "article";
};

const { site } = config;

const {
  title = site.title,
  description = site.description,
  ogImage = resolveDefaultOgImagePath(config),
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  ogType = "website",
} = Astro.props;

const socialImageURL = new URL(ogImage, Astro.site ?? Astro.url);
/*
  末尾那个斜杠必须去掉。getRelativeLocaleUrl 按 Astro 的 trailingSlash 规则
  给路径补斜杠 —— 对目录型路由（/posts/xxx/）是对的，但 rss.xml 是**文件**：
  产物里就叫 dist/rss.xml，没有 rss.xml/index.html。补了斜杠之后
  Cloudflare 的 auto-trailing-slash 找不到东西，直接落进 404 页。

  这条链接是 RSS 的 autodiscovery 入口 —— 阅读器订阅本站域名时读的就是它，
  所以指错了不是「少个斜杠」，是全站订阅不上（线上实测 /rss.xml/ → 404）。

  仍然走 getRelativeLocaleUrl 而不是写死 "/rss.xml"：base 前缀和将来可能加回
  的语言前缀都还由它算。这里只削掉最后那一个斜杠。
  （getPostUrl 的调用点也是同一个写法，见 pages/posts/[...slug]/index.astro。）
*/
const rssHref = getRelativeLocaleUrl(
  Astro.currentLocale ?? config.site.lang,
  "rss.xml"
).replace(/\/+$/, "");

/*
  站标的缓存版本号。**换了站标就把这个数字 +1。**

  为什么需要它：浏览器把 favicon 存在一个和普通 HTTP 缓存分开的库里
  （Chrome 的 Favicons、Firefox 的 favicons.sqlite），那个库基本不看
  cache-control，Ctrl+Shift+R 也刷不掉。所以换了图标之后，**所有访问过
  这个站的人**都可能长期继续看到旧图标 —— 我们这次就是从 Astro 的 logo
  换成自己的站标，不加这个的话老访客会一直看到 Astro 那个 A。

  换 URL 是唯一可靠的办法：不同 URL 就是不同缓存键。
  getAssetPath 只做去前导斜杠 + 拼接，查询串能安全穿过。
*/
const ICON_VERSION = 2;
---

<!doctype html>
<html
  dir={site.dir ?? "ltr"}
  lang={Astro.currentLocale ?? site.lang}
  class="overflow-y-scroll scroll-smooth"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      站标是一颗带环的行星（克拉克带 = 地球同步轨道那条环带）。
      三份都由 public/favicon.svg 派生，改了标就要重新生成后两份、
      并且把上面的 ICON_VERSION +1 —— 步骤记在 docs/站标.md 里。

      顺序有讲究：现代浏览器认 svg 那条就不会再去要 ico。
      svg 里带 prefers-color-scheme，所以标签页图标会跟系统主题走；
      ico 和 apple-touch-icon 没有这个能力，都是浅色版栅格化。
    -->
    <link
      rel="icon"
      type="image/svg+xml"
      href={getAssetPath(`favicon.svg?v=${ICON_VERSION}`)}
    />
    <link rel="icon" href={getAssetPath(`favicon.ico?v=${ICON_VERSION}`)} />
    <link
      rel="apple-touch-icon"
      href={getAssetPath(`apple-touch-icon.png?v=${ICON_VERSION}`)}
    />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Font -->
    <Font
      cssVariable="--font-google-sans-code"
      preload={[{ subset: "latin", weight: 400, style: "normal" }]}
    />
    <!-- 自托管的 Michroma（Atomic Rockets 同款），只用于拉丁标题 -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={getAssetPath("fonts/michroma-latin.woff2")}
      crossorigin
    />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="sitemap" href={getAssetPath("sitemap-index.xml")} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Twitter / X -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <!-- RSS autodiscovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href={new URL(rssHref, Astro.site)}
    />

    <!-- Filled at runtime by theme.ts to match the current background colour -->
    <meta name="theme-color" content="" />

    <!-- Extra head content injected by child layouts (e.g. JSON-LD, article meta) -->
    <slot name="head" />

    {
      site.googleVerification && (
        <meta
          name="google-site-verification"
          content={site.googleVerification}
        />
      )
    }

    <!--
      Inline FOUC-prevention script: sets data-theme on <html> before
      the browser paints. Runs synchronously, no defer/async.
    -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        const theme = stored ?? (prefersDark ? "dark" : "light");
        const root = document.firstElementChild;
        root?.setAttribute("data-theme", theme);
        root?.classList.toggle("dark", theme === "dark");
        // Expose value so theme.ts can skip re-detection.
        window.__theme = { value: theme };
      })();
    </script>

    <ClientRouter />
  </head>
  <body
    class="bg-background font-app text-foreground selection:bg-accent/75 selection:text-accent-foreground flex min-h-svh flex-col"
  >
    <!--
      环境背景：深空。星场 + 星云 + 一道行星边缘，全部是 CSS 画的，没有图片请求。
      两个主题共用同一张底 —— 明暗切换换的是上面那块内容面板，不是这里。
      整块 fixed，不随滚动，所以长文章不会因此多出一个几万像素高的合成层。
      画法和参数见 styles/glass.css。
    -->
    <div class="site-backdrop" aria-hidden="true"></div>
    <slot />
    <script>
      import "@/scripts/theme";
    </script>
  </body>
</html>
