---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const currentYear = new Date().getFullYear();

/*
  版权行里的字标带 lang="en"：整页是 lang="zh"，不标的话屏幕阅读器会用
  中文的发音规则去念 clarkebelt。视觉上没有任何变化。

  它跟着「站名是拉丁字母」这个前提走 —— 站名改成中文就该去掉，
  连同 Header.astro 那一处。完整理由在 Header.astro 顶部注释第 1 条。
*/
---

<footer
  class:list={["app-shell", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="border-border flex flex-col items-center justify-between border-t py-6 sm:flex-row-reverse sm:py-4"
  >
    <Socials />
    <div class="my-2 flex flex-col items-center whitespace-nowrap sm:flex-row">
      <span>
        &#169; {currentYear}{" "}
        <span class="font-display" lang="en">{config.site.title}</span>
      </span>
      <span class="hidden sm:inline">&nbsp;·&nbsp;</span>
      <span>
        内容采用{" "}
        <a
          class="hover:text-accent underline decoration-dashed underline-offset-4"
          href="https://creativecommons.org/licenses/by-sa/4.0/deed.zh-hans"
          target="_blank"
          rel="license noopener noreferrer"
        >
          CC BY-SA 4.0
        </a>{" "}
        协议共享
      </span>
    </div>
  </div>
</footer>
