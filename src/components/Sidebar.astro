---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import ArchiveTree from "./ArchiveTree.astro";
import TableOfContents from "./TableOfContents.astro";
import Tag from "./Tag.astro";
import { postFilter } from "@/utils/postFilter";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { useTranslations } from "@/i18n";
import config from "@/config";

/*
  常驻右侧栏。结构对标 ToughSF（Blogger）的侧栏 widget 组合：
  BlogSearch → Label/分类 → BlogArchive → Text（外链）→ Profile。

  ⚠️ 下面这份参考站点名单属于「内容」，改成你自己的。
*/
const referenceLinks = [
  {
    label: "Atomic Rockets",
    href: "https://projectrho.com/public_html/rocket/",
  },
  { label: "Orion's Arm", href: "https://www.orionsarm.com/" },
  { label: "ToughSF", href: "https://toughsf.blogspot.com/" },
];

/*
  headings 只有文章页会传。传了就在侧栏最顶上多一块目录 —— 放在搜索框之前，
  因为读者在文章页里对侧栏的第一诉求是「这篇有多长、讲了几件事」，
  不是站内搜索。列表页不传，侧栏就是原来那四块。
*/
type Props = {
  headings?: { depth: number; slug: string; text: string }[];
};

const { headings } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = (await getCollection("posts")).filter(postFilter);
const tags = getUniqueTags(posts);

const searchPath = getRelativeLocaleUrl(locale, "search");
const aboutPath = getRelativeLocaleUrl(locale, "about");
const archivesPath = getRelativeLocaleUrl(locale, "archives");
const tagsPath = getRelativeLocaleUrl(locale, "tags");

const headingClass =
  "border-border/70 text-muted-foreground mb-3 border-b pb-1.5 text-xs font-semibold tracking-widest";
const moreLinkClass =
  "text-accent mt-3 inline-flex items-center gap-1 text-xs decoration-dashed underline-offset-4 hover:underline";
---

<!--
  贴顶位置跟着 --below-header 走，别写死像素：理由见 global.css 里那段注释。

  lg:mt-4 是对齐用的，不是留白：版心（.content-panel）自带 1rem 上外边距，
  侧栏不补同样一档的话，两栏的第一行就差 16px 错开 —— 中间那条栏线会把
  这点错位放大得很明显。两个数必须一起改。
-->
<aside
  aria-label={t.sidebar.label}
  class="lg:sticky lg:top-(--below-header) lg:mt-4 lg:self-start"
>
  <div
    class="space-y-8 lg:max-h-[calc(100svh_-_var(--below-header)_-_2rem)] lg:overflow-y-auto lg:pe-1"
  >
    {headings && <TableOfContents {headings} />}

    {
      config.features.search === "pagefind" && (
        <section>
          <h2 class={headingClass}>{t.nav.search}</h2>
          {/* 直接 GET 到搜索页；search.astro 会读 ?q= 并触发 Pagefind */}
          <form
            action={searchPath}
            method="get"
            role="search"
            class="flex gap-2"
          >
            <label class="sr-only" for="sidebar-search">
              {t.a11y.searchPlaceholder}
            </label>
            <input
              id="sidebar-search"
              type="search"
              name="q"
              placeholder={t.a11y.searchPlaceholder}
              class="border-border focus-visible:border-accent min-w-0 flex-1 rounded-md border bg-transparent px-2 py-1.5 text-sm"
            />
            <button
              type="submit"
              class="border-border hover:text-accent hover:border-accent rounded-md border px-2"
              aria-label={t.nav.search}
            >
              <IconSearch class="size-4" />
            </button>
          </form>
        </section>
      )
    }

    {
      tags.length > 0 && (
        <section>
          <h2 class={headingClass}>{t.nav.tags}</h2>
          <ul class="flex flex-wrap gap-x-4 gap-y-2">
            {tags.slice(0, 12).map(({ tag, tagName }) => (
              <Tag {tag} {tagName} size="sm" />
            ))}
          </ul>
          {tags.length > 12 && (
            <a href={tagsPath} class={moreLinkClass}>
              {t.sidebar.allTags}
              <IconArrowRight class="size-3.5 rtl:-rotate-180" />
            </a>
          )}
        </section>
      )
    }

    {
      posts.length > 0 && config.features.showArchives && (
        <section>
          <h2 class={headingClass}>{t.nav.archives}</h2>
          {/* summary 模式：只渲染年/月计数。侧栏出现在每一页，
              渲染全部文章标题会让站点总体积变成 O(文章数²)。 */}
          <ArchiveTree {posts} mode="summary" {archivesPath} />
          <a href={archivesPath} class={moreLinkClass}>
            {t.sidebar.allArchives}
            <IconArrowRight class="size-3.5 rtl:-rotate-180" />
          </a>
        </section>
      )
    }

    {
      referenceLinks.length > 0 && (
        <section>
          <h2 class={headingClass}>{t.sidebar.referenceLinks}</h2>
          <ul class="space-y-1.5 text-sm">
            {referenceLinks.map(({ label, href }) => (
              <li>
                <a
                  {href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-accent decoration-dashed underline-offset-4 hover:underline"
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section>
      <h2 class={headingClass}>{t.nav.about}</h2>
      {/* 站点简介来自 config.site.description —— 你自己的文案，这里不另造 */}
      <p class="text-muted-foreground text-sm leading-relaxed">
        {config.site.description}
      </p>
      <a href={aboutPath} class={moreLinkClass}>
        {t.nav.about}
        <IconArrowRight class="size-3.5 rtl:-rotate-180" />
      </a>
    </section>
  </div>
</aside>
