---
import { getRelativeLocaleUrl } from "astro:i18n";
import Sidebar from "./Sidebar.astro";
import config from "@/config";

type Props = {
  pageTitle: string | [string, string];
  pageDesc?: string;
  class?: string;
  /** 关掉常驻右侧栏（搜索页本身就是全宽结果列表，不需要） */
  sidebar?: boolean;
};

const { pageTitle, pageDesc, class: className, sidebar = true } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const backUrl = config.features.showBackButton
  ? Astro.url.pathname
  : getRelativeLocaleUrl(locale, "");
---

<div class:list={["app-shell", { "app-with-sidebar": sidebar }]}>
  {
    /*
      注意用的是 {/* *\/} 而不是 <!-- -->：Astro 会把 HTML 注释原样输出到
      每一个页面里，这段说明就成了几百字节的死重量。花括号注释只存在于源码。

      content-panel：版心。名字是历史遗留 —— 它已经不是一块「面板」了，
      没有底色差也没有边框，只负责上下呼吸和右边那条栏线（见
      styles/surfaces.css）。404 页故意没挂：那页的 main 是个居中容器。
    */
  }
  <main
    data-backUrl={backUrl}
    id="main-content"
    class:list={["content-panel min-w-0", className]}
  >
    <h1 class="text-heading font-serif text-2xl font-semibold sm:text-3xl">
      {pageTitle}
    </h1>
    {/* 副标题的「次要感」用灰色给，不用 italic —— 中文没有斜体字形 */}
    <p class="text-muted-foreground mt-2 mb-6">{pageDesc}</p>
    <slot />
  </main>
  {sidebar && <Sidebar />}
</div>

<script>
  const mainContent: HTMLElement | null =
    document.querySelector("#main-content");
  const backUrl = mainContent?.dataset?.backurl;
  if (backUrl) {
    sessionStorage.setItem("backUrl", backUrl);
  }
</script>
