---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconHash from "@/assets/icons/IconHash.svg";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
  /*
    关掉 view transition 的形变动画。

    每个 transition scope 会让 Astro 往页面里内联约 1.1KB CSS
    （压缩后仍占整页 gzip 体积的一大块）。侧栏那份标签列表出现在
    **每一个页面**上，12 个 chip 就是白搭 ~13KB/页；而从常驻侧栏点标签
    本来也看不出形变——源和目标不是同一个视觉元素。
    真正需要动画的是 /tags 列表页和文章底部那份标签，那两处保持默认。
  */
  animate?: boolean;
};

const { tag, tagName, size = "lg", animate = true } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const href = getRelativeLocaleUrl(locale, `tags/${tag}/`);

/*
  transition:name 是编译期指令，传 undefined 照样会生成 scope，
  所以只能分两个分支。样式全提到这里，重复的只有 <a> 标签本身。
*/
const linkClass = [
  "flex items-center gap-0.5",
  "border-foreground border-b-2 border-dashed",
  "hover:border-accent hover:text-accent hover:-mt-0.5",
  "focus-visible:text-accent focus-visible:border-none",
  { "text-sm": size === "sm" },
  { "text-lg": size === "lg" },
];

const iconClass = [
  "opacity-80",
  { "size-5": size === "lg" },
  { "size-4": size === "sm" },
];
---

<li>
  {
    animate ? (
      <a {href} transition:name={tag} class:list={linkClass}>
        <IconHash class:list={iconClass} />
        {tagName}
      </a>
    ) : (
      <a {href} class:list={linkClass}>
        <IconHash class:list={iconClass} />
        {tagName}
      </a>
    )
  }
</li>
