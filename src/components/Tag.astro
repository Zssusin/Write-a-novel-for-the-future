---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const href = getRelativeLocaleUrl(locale, `tags/${tag}/`);

/*
  标签是「铭牌」：1px 边框的小方块（直角来自全局压平的圆角阶），
  不再是 # 加虚线下划线 —— # 是社交平台的话题习惯，图纸上没有这个。
  悬停时边框和文字一起换 accent，没有位移动效（原来的 -mt-0.5 上跳
  是俏皮话，手册不说俏皮话）。
*/
const linkClass = [
  "inline-flex items-center border px-2 py-0.5 tracking-wide",
  "border-border hover:border-accent hover:text-accent",
  "focus-visible:text-accent",
  { "text-xs": size === "sm" },
  { "text-sm": size === "lg" },
];
---

<li>
  <a {href} class:list={linkClass}>
    {tagName}
  </a>
</li>
