---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Sidebar from "@/components/Sidebar.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
const postsPath = getRelativeLocaleUrl(locale, "posts/");
const aboutPath = getRelativeLocaleUrl(locale, "about/");

/*
  首页得自己写一份 <title>，不能让 Layout 回落到 site.title —— 那样整页标题
  就只有 "clarkebelt" 十个字符，搜索结果里光一个品牌词，读者看不出这站是干嘛的。
  （Bing 站长工具把它报成 Title too short，它的门槛是 15 字符。）

  其他页不受影响：它们各自拼 "xx | clarkebelt"，用的是 site.title 不是这个常量。

  长度上限比下限更值得盯：Google 中文结果大约 30 个全角宽度就截断。
  这条按全角折算 ≈ 24.5（拉丁字母算半宽），留了点余量 —— 往后加字先数一下。
*/
const homeTitle = `${config.site.title} · 硬科幻笔记：现实科技解读与创作工具箱`;

/*
  同理，首页的 <meta name="description"> 也得自己写。回落到 site.description
  的话，它跟上面这行标题几乎是同一句话（都在列栏目），搜索结果里两行重说一遍，
  白扔一行展示位。所以这份只讲标题没说的：**怎么做**（翻译 + 注解、标清事实与
  推测）和**选文标准**（不日更不求全）。

  别改成动 site.description —— 那个是全站兜底，还兼着 RSS 频道简介
  （src/pages/rss.xml.ts），动了会波及一片。

  长度奔 60~80 个全角去：太短 Google 会自己扒正文来凑，而首页正文头一句是
  「你好，旅行者」，扒出来没法看。这条 67 个字，也留在截断线以内。
*/
const homeDesc =
  "把国外真正硬核的科技长文译成中文，补上背景、标清哪些是事实、哪些是推测。" +
  "另有原创短篇、设定方法与书单。不日更、不求全，只留能反复回看的。";
---

<Layout title={homeTitle} description={homeDesc}>
  <Header />
  <div class="app-shell app-with-sidebar">
    <main
      id="main-content"
      data-layout="index"
      data-home-path={homePath}
      class="content-panel min-w-0"
    >
      <section id="hero" class="border-border border-b pb-6">
        <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
          你好，旅行者
        </h1>
        <a
          target="_blank"
          href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
          class="inline-block"
          aria-label="RSS Feed"
          title="RSS Feed"
        >
          <IconRss
            width={20}
            height={20}
            class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
          />
          <span class="sr-only">RSS Feed</span>
        </a>

        <p>
          这里是
          clarkebelt——一个硬科幻爱好者的笔记本。现实科技的解读与翻译、原创故事、给科幻作者的工具箱，以及值得一读的书单，都收在这里。
        </p>
        <p class="mt-2">
          从{" "}
          <LinkButton
            class="hover:text-accent underline decoration-dashed underline-offset-4"
            href={postsPath}
          >
            最新文章
          </LinkButton>{" "}
          开始读，或先看看{" "}
          <LinkButton
            class="hover:text-accent underline decoration-dashed underline-offset-4"
            href={aboutPath}
          >
            关于
          </LinkButton>
          。
        </p>
        {
          socials.length > 0 && (
            <div class="mt-4 flex max-sm:flex-col sm:items-center">
              <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
                {t.home.socialLinks}:
              </div>
              <Socials />
            </div>
          )
        }
      </section>

      {
        featuredPosts.length > 0 && (
          <section
            id="featured"
            class:list={[
              "pt-12 pb-6",
              { "border-border border-b": recentPosts.length > 0 },
            ]}
          >
            <h2 class="text-2xl font-semibold tracking-wide">
              {t.home.featured}
            </h2>
            <ul>
              {/* 第一张是首页的 LCP 元素，理由见 Card.astro 里 priority 那段 */}
              {featuredPosts.map((data, i) => (
                <Card variant="h3" priority={i === 0} {...data} />
              ))}
            </ul>
          </section>
        )
      }

      {
        recentPosts.length > 0 && (
          <section id="recent-posts" class="pt-12 pb-6">
            <h2 class="text-2xl font-semibold tracking-wide">
              {t.home.recentPosts}
            </h2>
            <ul>
              {/* featured 为空时，顶在最上面的才是 recent 的第一张 */}
              {recentPosts.slice(0, postsConfig.perIndex).map((data, i) => (
                <Card
                  variant="h3"
                  priority={featuredPosts.length === 0 && i === 0}
                  {...data}
                />
              ))}
            </ul>
          </section>
        )
      }

      <div class="my-8 text-center">
        <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
          {t.home.allPosts}
          <IconArrowRight class="inline-block rtl:-rotate-180" />
        </LinkButton>
      </div>
    </main>
    <Sidebar />
  </div>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
