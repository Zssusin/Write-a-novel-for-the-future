---
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowNarrowUp from "@/assets/icons/IconArrowNarrowUp.svg";
import { useTranslations } from "@/i18n";

const t = useTranslations(Astro.currentLocale);
---

{
  /*
    定位一律用 sticky，手机上也是 —— 这里**不能**用 fixed。

    本组件挂在 <main class="content-panel"> 里面，而 .content-panel 带
    backdrop-filter（glass.css，把面板背后的星点糊成均匀辉光）。按 CSS 规范，
    backdrop-filter 不为 none 的元素会成为其 fixed 后代的**包含块** ——
    于是 position:fixed 锚的不再是视口，而是那块面板。实测 390×844 下
    按钮的 bottom 落在 8387px（面板底部 8364 之下），整个跑到屏幕外，
    手机上那颗悬浮球就此消失；把 backdrop-filter 临时改成 none，
    同一处立刻回到 868px（视口内）—— 这就是对照实验的结论。

    md 档原本就是 sticky，所以这里只是把手机档统一到同一套机制：
    bottom-8 让它悬在视口底部上方 2rem，float-end 贴右侧内边距，
    效果和原来的 fixed 一致，区别只是滚出 <main> 之后（页脚区域）
    它会跟着走，而不是继续钉在屏幕上。

    ⚠️ 别改回 fixed。除非先把这个组件挪出 .content-panel。
  */
}
<div
  id="btt-btn-container"
  class:list={[
    "sticky bottom-8 z-50 float-end",
    "md:me-1",
    "translate-y-14 opacity-0 transition duration-500",
  ]}
>
  <button
    data-button="back-to-top"
    class:list={[
      "group bg-background relative px-2 py-1",
      "size-14 rounded-full shadow-xl",
      "md:h-8 md:w-fit md:rounded-md md:shadow-none md:focus-visible:rounded-none",
      "md:bg-background/35 md:bg-clip-padding md:backdrop-blur-lg",
    ]}
  >
    <span
      id="progress-indicator"
      class="absolute inset-0 -z-10 block size-14 scale-110 rounded-full bg-transparent md:hidden md:h-8 md:rounded-md"
    ></span>
    <IconArrowLeft class="inline-block rotate-90 md:hidden" />
    <span class="group-hover:text-accent sr-only text-sm md:not-sr-only">
      <IconArrowNarrowUp class="inline-block size-4" />
      {t.post.backToTop}
    </span>
  </button>
</div>

<script is:inline data-astro-rerun>
  function backToTop() {
    const rootElement = document.documentElement;
    const btnContainer = document.querySelector("#btt-btn-container");
    const backToTopBtn = document.querySelector("[data-button='back-to-top']");
    const progressIndicator = document.querySelector("#progress-indicator");

    if (!rootElement || !btnContainer || !backToTopBtn || !progressIndicator)
      return;

    backToTopBtn.addEventListener("click", () => {
      document.body.scrollTop = 0;
      document.documentElement.scrollTop = 0;
    });

    let lastVisible = null;
    function handleScroll() {
      /*
        从文章页转到没有这个按钮的页面（首页、标签页）时，这段脚本不再重跑，
        下面那个指针就一直指着这一页的闭包。不认出来的话，往后每个滚动帧都要
        为一堆已经脱离文档的元素白读一次 scrollHeight —— 而那是强制同步布局。
      */
      if (!btnContainer.isConnected) return;

      const scrollTotal = rootElement.scrollHeight - rootElement.clientHeight;
      const scrollTop = rootElement.scrollTop;
      const scrollPercent = Math.floor((scrollTop / scrollTotal) * 100);

      progressIndicator.style.setProperty(
        "background-image",
        `conic-gradient(var(--accent), var(--accent) ${scrollPercent}%, transparent ${scrollPercent}%)`
      );

      const isVisible = scrollTop / scrollTotal > 0.3;

      if (isVisible !== lastVisible) {
        btnContainer.classList.toggle("opacity-100", isVisible);
        btnContainer.classList.toggle("translate-y-0", isVisible);
        btnContainer.classList.toggle("opacity-0", !isVisible);
        btnContainer.classList.toggle("translate-y-14", !isVisible);
        lastVisible = isVisible;
      }
    }

    /*
      scroll 监听器只绑一次，处理函数每次导航换成新的那个。

      这段脚本带着 data-astro-rerun，每导航一次就整段重跑；而 ClientRouter
      换的是 <body> 内容，document 本身活过换页 —— 直接绑的话监听器只增不减，
      翻十页就有十份 handleScroll 在每个滚动帧里跑，每份还各读一次
      scrollHeight/clientHeight（强制同步布局），旧的那些又拽着上一页
      已经脱离文档的 btnContainer 不放。这和 index.astro 末尾
      __scrollResetBound 挡的是同一个坑。

      闸只设在监听器上：上面 handleScroll 闭包里的 btnContainer、
      progressIndicator、lastVisible 全部属于当前这一页，不能让第一页的
      那份一直用下去，所以每次重跑都把指针换成新的。
    */
    window.__bttHandleScroll = handleScroll;

    if (!window.__bttScrollBound) {
      window.__bttScrollBound = true;
      let ticking = false;
      document.addEventListener("scroll", () => {
        if (!ticking) {
          window.requestAnimationFrame(() => {
            window.__bttHandleScroll?.();
            ticking = false;
          });
          ticking = true;
        }
      });
    }
  }
  backToTop();
</script>
