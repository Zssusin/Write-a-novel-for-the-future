---
import IconArrowNarrowUp from "@/assets/icons/IconArrowNarrowUp.svg";
import { useTranslations } from "@/i18n";

const t = useTranslations(Astro.currentLocale);
---

{
  /*
    定位一律用 sticky，手机和桌面端保持一致。

    历史包袱，想改成 fixed 之前先读：玻璃时代的 .content-panel 带
    backdrop-filter，按 CSS 规范它会成为 fixed 后代的**包含块**，
    fixed 按钮直接锚到面板底部跑出屏幕（实测 390×844 下 bottom 落在
    8387px，视口外）。现在面板是实色的（surfaces.css），fixed 理论上
    能用了 —— 但 sticky 的行为完全够用，而且不依赖「面板身上没有
    backdrop-filter / filter / transform」这种隐式前提：谁哪天给面板
    加一条 filter，都不会再悄悄弄丢这颗按钮。所以维持 sticky。
  */
}
<div
  id="btt-btn-container"
  class:list={[
    "sticky bottom-8 z-50 float-end",
    "me-1",
    "translate-y-14 opacity-0 transition duration-500 motion-reduce:transition-none",
  ]}
>
  <button
    data-button="back-to-top"
    data-label={t.post.backToTop}
    aria-label={t.post.backToTop}
    title={t.post.backToTop}
    class:list={[
      // 实底 + 边线，手册风的层次只靠线给（surfaces.css）
      // 全端保持圆钮（theme.css:26），外圈承载进度环，内显箭头与数字进度
      "group bg-background border-border hover:border-accent/60 relative flex flex-col items-center justify-center border",
      "size-14 rounded-full transition-colors md:size-12",
    ]}
  >
    <span
      id="progress-indicator"
      class="absolute inset-0 -z-10 block scale-110 rounded-full bg-transparent"
    ></span>
    <IconArrowNarrowUp
      class="text-foreground group-hover:text-accent size-4.5 transition-all duration-200 group-hover:-translate-y-0.5 md:size-4"
      aria-hidden="true"
    />
    <span
      id="progress-percent"
      class="text-muted-foreground group-hover:text-accent mt-0.5 font-mono text-[11px] leading-none font-semibold transition-colors md:text-[10px]"
    >
      0%
    </span>
    <span class="sr-only">{t.post.backToTop}</span>
  </button>
</div>

<script>
  const rootElement = document.documentElement;
  const btnContainer = document.querySelector("#btt-btn-container");
  const backToTopBtn = document.querySelector<HTMLButtonElement>(
    "[data-button='back-to-top']"
  );
  const progressIndicator = document.querySelector<HTMLElement>(
    "#progress-indicator"
  );
  const progressPercent =
    document.querySelector<HTMLElement>("#progress-percent");

  if (btnContainer && backToTopBtn && progressIndicator) {
    backToTopBtn.addEventListener("click", () => {
      document.body.scrollTop = 0;
      document.documentElement.scrollTop = 0;
    });

    const baseLabel = backToTopBtn.dataset.label ?? "回到顶部";
    let lastVisible: boolean | null = null;
    const handleScroll = () => {
      const scrollTotal = rootElement.scrollHeight - rootElement.clientHeight;
      const scrollTop = rootElement.scrollTop;
      const scrollPercent =
        scrollTotal > 0
          ? Math.min(
              100,
              Math.max(0, Math.round((scrollTop / scrollTotal) * 100))
            )
          : 0;

      progressIndicator.style.setProperty(
        "background-image",
        `conic-gradient(var(--accent), var(--accent) ${scrollPercent}%, transparent ${scrollPercent}%)`
      );

      if (progressPercent) {
        progressPercent.textContent = `${scrollPercent}%`;
      }

      const dynamicLabel = `${baseLabel} (${scrollPercent}%)`;
      backToTopBtn.setAttribute("title", dynamicLabel);
      backToTopBtn.setAttribute("aria-label", dynamicLabel);

      const isVisible = scrollTotal > 0 && scrollTop / scrollTotal > 0.3;

      if (isVisible !== lastVisible) {
        btnContainer.classList.toggle("opacity-100", isVisible);
        btnContainer.classList.toggle("translate-y-0", isVisible);
        btnContainer.classList.toggle("opacity-0", !isVisible);
        btnContainer.classList.toggle("translate-y-14", !isVisible);
        lastVisible = isVisible;
      }
    };

    // 初始化执行一次，确保带有 hash 锚点或恢复滚动位置进页面时正确展示
    handleScroll();

    // scroll 每帧都触发，而 handleScroll 要读 scrollHeight/clientHeight
    // （强制同步布局），rAF 把它压到每帧最多一次。
    let ticking = false;
    document.addEventListener("scroll", () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          handleScroll();
          ticking = false;
        });
        ticking = true;
      }
    });
  }
</script>
