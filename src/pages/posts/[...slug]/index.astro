---
import { type CollectionEntry, getCollection, render } from "astro:content";
import PostLayout from "@/layouts/PostLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import Sidebar from "@/components/Sidebar.astro";
import ReadingTime from "@/components/ReadingTime.astro";
import Comments from "@/components/Comments.astro";
import Tag from "@/components/Tag.astro";
import SeriesNav from "@/components/SeriesNav.astro";
import SourceNote from "@/components/SourceNote.astro";
import { getPostSlug, getPostUrl } from "@/utils/getPostPaths";
import { getSeriesIndex, type SeriesPart } from "@/utils/getSeries";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { slugifyStr } from "@/utils/slugify";
import { toTransitionName } from "@/utils/toTransitionName";
import { useTranslations } from "@/i18n";
import EditPost from "./_components/EditPost.astro";
import ShareLinks from "./_components/ShareLinks.astro";
import BackButton from "./_components/BackButton.astro";
import BackToTopButton from "./_components/BackToTopButton.astro";
import AdjacentPostNav from "./_components/AdjacentPostNav.astro";
import config from "@/config";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const sortedPosts = getSortedPosts(posts);
  // 整站的系列索引只建一次，再分给各篇 —— 别在每个页面里重算一遍
  const seriesIndex = getSeriesIndex(posts);

  return sortedPosts.map((post, index) => ({
    params: { slug: getPostSlug(post.id, post.filePath) },
    props: {
      post,
      seriesParts: post.data.series
        ? (seriesIndex.get(post.data.series.name) ?? [])
        : [],
      prevPost:
        index > 0
          ? {
              id: sortedPosts[index - 1].id,
              title: sortedPosts[index - 1].data.title,
              filePath: sortedPosts[index - 1].filePath,
            }
          : null,
      nextPost:
        index < sortedPosts.length - 1
          ? {
              id: sortedPosts[index + 1].id,
              title: sortedPosts[index + 1].data.title,
              filePath: sortedPosts[index + 1].filePath,
            }
          : null,
    },
  }));
}

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
} | null;

type Props = {
  post: CollectionEntry<"posts">;
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
  seriesParts: SeriesPart[];
};

/*
  显式标注成 Props，而不是让它自己推。

  Astro.props 在这种页面上本来就是从 getStaticPaths 的返回值推出来的，两边
  形状一致时这行注解不改变任何类型 —— 它的作用是**让上面那个 Props 真的被用到**。
  不写的话 TS 会报 ts(6196)「Props 声明了但没用过」：那个类型只是躺在文件里
  给人看，编译器并不拿它校验任何东西，getStaticPaths 少给一个字段也不会响。

  加上之后，Props 就成了这两者之间的合同：getStaticPaths 的产出必须能塞进它。
*/
const { post, prevPost, nextPost, seriesParts }: Props = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const {
  title,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  hideEditPost,
  series,
  source,
  uid,
} = post.data;

/*
  headings 是 Astro 解析 markdown 时顺带产出的标题表（含正文里实际用的 id），
  给右侧栏的目录用；remarkPluginFrontmatter 是 remark 插件往 frontmatter 上
  写的东西 —— 这里只有 utils/remark/readingTime.ts 塞的那两个数。

  注意它**不是** post.data：post.data 是 zod 校验过的那份，只含文件里真写了的
  字段。构建期算出来的值走的是这条通道。
*/
const { Content, headings, remarkPluginFrontmatter } = await render(post);

const readingTime = remarkPluginFrontmatter.readingTime as number | undefined;
const wordCount = remarkPluginFrontmatter.wordCount as number | undefined;
// utils/remark/mathFlag.ts 塞的：真值时 PostLayout 才挂 KaTeX 的样式表
const hasMath = remarkPluginFrontmatter.hasMath === true;

let ogImageUrl: string | undefined;

if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage;
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src;
}

if (!ogImageUrl && config.features.dynamicOgImage) {
  const postUrl = getPostUrl(post.id, post.filePath, locale).replace(
    /\/+$/,
    ""
  );
  ogImageUrl = `${postUrl}/index.png`;
}

const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;
---

<PostLayout
  title={`${title} | ${config.site.title}`}
  headline={title}
  description={description}
  ogImage={ogImage}
  canonicalURL={canonicalURL}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
  {hasMath}
>
  <Header />

  <BackButton />

  <div class="app-shell app-with-sidebar">
    <main
      id="main-content"
      class:list={[
        "content-panel min-w-0",
        { "mt-8": !config.features.showBackButton },
      ]}
      data-pagefind-body
    >
      <h1
        style={{ viewTransitionName: toTransitionName(title) }}
        class="text-accent inline-block text-2xl font-bold sm:text-3xl"
      >
        {title}
      </h1>

      {/* flex-wrap：手机上日期 + 时长 + 字数一行放不下，让它自己折行 */}
      <div class="my-2 flex flex-wrap items-center gap-x-2 gap-y-1">
        <Datetime {pubDatetime} {modDatetime} {timezone} size="lg" />
        <span aria-hidden="true" class="text-muted-foreground">|</span>
        <ReadingTime minutes={readingTime} words={wordCount} />
        <span
          aria-hidden="true"
          class:list={[
            "text-muted-foreground max-sm:hidden",
            { hidden: !config.features.editPost?.enabled || hideEditPost },
          ]}
        >
          |
        </span>
        <EditPost {hideEditPost} {post} class="max-sm:hidden" />
      </div>

      {/* 出处在前、目录在后：先交代「这是谁的文章」，再交代「读到哪了」 */}
      {source && <SourceNote {...source} />}
      {
        series && (
          <SeriesNav
            name={series.name}
            parts={seriesParts}
            currentPart={series.part}
            variant="toc"
          />
        )
      }

      {
        /*
        data-lightbox 是给 scripts/lightbox.ts 的文案通道。那是个客户端模块，
        拿不到 Astro 的 i18n，所以在这里序列化一份传过去 —— 否则中文站上会
        出现 "Zoom image" 这样的英文 aria-label（改成模块之前就是这样）。
      */
      }
      <article
        id="article"
        data-lightbox={JSON.stringify(t.lightbox)}
        class:list={[
          "mt-8 w-full",
          "app-prose max-w-app",
          "prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)",
        ]}
      >
        <Content />
      </article>

      <hr class="my-8 border-dashed" />

      {/* 读完就接着读下一部分，不用滚回顶部找目录 */}
      {
        series && (
          <SeriesNav
            name={series.name}
            parts={seriesParts}
            currentPart={series.part}
            variant="next"
          />
        )
      }

      <EditPost class="sm:hidden" {hideEditPost} {post} />

      <BackToTopButton />

      <ul class="mt-4 mb-8 flex flex-wrap gap-4 sm:my-8">
        {tags.map(tag => <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />)}
      </ul>

      <ShareLinks />

      <hr class="my-8 border-dashed" />

      <AdjacentPostNav {prevPost} {nextPost} />

      {
        /*
        评论放在「上一篇/下一篇」之后：想继续读的读者不用先滚过整个评论区。

        判断写在**这里**而不是只写在 Comments 内部，是有实际后果的：Astro 收集
        <script> 的依据是「这个组件有没有被渲染」，不是「它有没有吐出 HTML」。
        让 Comments 渲染然后内部返回空，那段 giscus 脚本照样会被打进每个文章页
        —— 实测 960 字节的死代码，还会白挂一个 MutationObserver。
        在这里短路掉，关着评论时文章页就一个字节都不多。
      */
      }
      {config.features.comments !== false && <Comments term={uid} />}
    </main>
    <Sidebar {headings} />
  </div>
  <Footer />
</PostLayout>

{
  /*
  灯箱是打包模块，不是下面那种内联脚本 —— 它 8 KB 出头，内联意味着
  每个文章页的 HTML 里各存一份明文。打包之后全站共用一个带哈希的文件，
  _headers 里 /_astro/* 的 immutable 规则接管，第二篇起零下载。
  代价是没有 data-astro-rerun 可用，翻页重新初始化写在那个文件末尾。
*/
}
<script>
  import "@/scripts/lightbox";
</script>

<script is:inline data-astro-rerun>
  function createProgressBar() {
    const progressContainer = document.createElement("div");
    progressContainer.className =
      "progress-container fixed top-0 z-10 h-1 w-full bg-background";

    const progressBar = document.createElement("div");
    progressBar.className = "progress-bar h-1 w-0 bg-accent";
    progressBar.id = "myBar";

    progressContainer.appendChild(progressBar);
    document.body.appendChild(progressContainer);
  }
  createProgressBar();

  function updateScrollProgress() {
    document.addEventListener("scroll", () => {
      const winScroll =
        document.body.scrollTop || document.documentElement.scrollTop;
      const height =
        document.documentElement.scrollHeight -
        document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      if (document) {
        const myBar = document.getElementById("myBar");
        if (myBar) {
          myBar.style.width = scrolled + "%";
        }
      }
    });
  }
  updateScrollProgress();

  function addHeadingLinks() {
    const headings = Array.from(
      document.querySelectorAll("h2, h3, h4, h5, h6")
    );
    for (const heading of headings) {
      heading.classList.add("group");
      const link = document.createElement("a");
      link.className =
        "heading-link ms-2 no-underline opacity-75 md:opacity-0 md:group-hover:opacity-100 md:focus:opacity-100";
      link.href = "#" + heading.id;

      const span = document.createElement("span");
      span.ariaHidden = "true";
      span.innerText = "#";
      link.appendChild(span);
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  function attachCopyButtons() {
    const copyButtonLabel = "Copy";
    const codeBlocks = Array.from(document.querySelectorAll("pre"));

    for (const codeBlock of codeBlocks) {
      const wrapper = document.createElement("div");
      wrapper.style.position = "relative";

      const computedStyle = getComputedStyle(codeBlock);
      const hasFileNameOffset =
        computedStyle.getPropertyValue("--file-name-offset").trim() !== "";

      const topClass = hasFileNameOffset
        ? "top-(--file-name-offset)"
        : "-top-3";

      const copyButton = document.createElement("button");
      copyButton.className = `copy-code absolute end-3 ${topClass} rounded bg-muted border border-muted px-2 py-1 text-xs leading-4 text-foreground font-medium`;
      copyButton.innerHTML = copyButtonLabel;
      codeBlock.setAttribute("tabindex", "0");
      codeBlock.appendChild(copyButton);

      codeBlock?.parentNode?.insertBefore(wrapper, codeBlock);
      wrapper.appendChild(codeBlock);

      copyButton.addEventListener("click", async () => {
        await copyCode(codeBlock, copyButton);
      });
    }

    async function copyCode(block, button) {
      const code = block.querySelector("code");
      const text = code?.innerText;

      await navigator.clipboard.writeText(text ?? "");

      button.innerText = "Copied";

      setTimeout(() => {
        button.innerText = copyButtonLabel;
      }, 700);
    }
  }
  attachCopyButtons();

  /*
    翻页后回到顶部。

    包在 __scrollResetBound 里，是因为外面这个 <script> 带着
    data-astro-rerun —— 每导航一次整段就重跑一次，不设闸的话
    astro:after-swap 上的监听器会一次次往上堆，翻十页就有十个。
    （灯箱原来那段用的也是这个写法，见 scripts/lightbox.ts 末尾。）
  */
  if (!window.__scrollResetBound) {
    window.__scrollResetBound = true;
    document.addEventListener("astro:after-swap", () =>
      window.scrollTo({ left: 0, top: 0, behavior: "instant" })
    );
  }
</script>
